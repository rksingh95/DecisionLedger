# ─────────────────────────────────────────────────────────────────────────────
#  DecisionLedger SDK — Local Development Environment
#
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
#
#  The server loads this file automatically via python-dotenv.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# API key used to authenticate SDK clients against this server.
# Any non-empty string works for local development.
DAI_API_KEY=dev-key-change-me-in-production

# Database connection string.
# SQLite — zero setup, works immediately for local dev:
DAI_DATABASE_URL=sqlite+aiosqlite:///./dev.db
# PostgreSQL — for production or when using Docker (make docker-up starts Postgres):
#DAI_DATABASE_URL=postgresql+asyncpg://dai:dai_dev_password@localhost:5432/dai

# ── Optional ──────────────────────────────────────────────────────────────────

# Backend the SDK uses when you run scripts locally (noop | sqlite | http)
# DAI_BACKEND=sqlite

# Logging level: DEBUG | INFO | WARNING | ERROR
# DAI_LOG_LEVEL=INFO

# Error policy when a commit/query fails: log_and_continue | raise_exception
# DAI_ON_ERROR=log_and_continue

# Comma-separated list of allowed CORS origins for the API server.
# DAI_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
